diff --git a/net/minecraft/server/level/RegionBlockEntityTicker.java b/net/minecraft/server/level/RegionBlockEntityTicker.java
new file mode 100644
index 0000000000000000000000000000000000000000..c7936a296fcc4bb3f938320b8dab1d35e9ea834d
--- /dev/null
+++ b/net/minecraft/server/level/RegionBlockEntityTicker.java
@@ -0,0 +1,174 @@
+package net.minecraft.server.level;
+
+import io.fand.server.tick.RegionTickExecutor;
+import io.fand.server.tick.TickRegion;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+import net.minecraft.world.level.block.entity.TickingBlockEntity;
+
+/** Executes independent native block-entity groups, joining before world publication resumes. */
+public final class RegionBlockEntityTicker {
+    private final ServerLevel level;
+    private final java.util.function.Supplier<io.fand.server.tick.RegionSimulationWorkers> workers;
+    private Snapshot snapshot = new Snapshot(0, 0, 0, 0, List.of());
+    private long completedPhases;
+    private long completedTickers;
+    private int peakConcurrency;
+
+    public RegionBlockEntityTicker(ServerLevel level) {
+        this(level, () -> io.fand.server.Main.runtime().regionSimulationWorkers());
+    }
+
+    RegionBlockEntityTicker(ServerLevel level, java.util.function.Supplier<io.fand.server.tick.RegionSimulationWorkers> workers) {
+        this.level = level;
+        this.workers = workers;
+    }
+
+    public Snapshot snapshot() {
+        if (!this.level.getServer().isSameThread()) {
+            throw new IllegalStateException("Region phase diagnostics belong to the control thread");
+        }
+        return this.snapshot;
+    }
+
+    public void tick(List<TickingBlockEntity> tickers, Consumer<TickingBlockEntity> tick) {
+        var workers = this.workers.get();
+        if (workers.parallelism() == 1) {
+            tickers.forEach(tick);
+            return;
+        }
+        Map<TickRegion, List<TickingBlockEntity>> groups = this.group(tickers);
+        List<TickingBlockEntity> candidates = new ArrayList<>();
+        for (var entry : groups.entrySet()) {
+            if (entry.getKey() != null && entry.getValue().stream().allMatch(TickingBlockEntity::fand$canTickInRegion)) {
+                candidates.addAll(entry.getValue());
+            } else {
+                entry.getValue().forEach(tick);
+            }
+        }
+        // Control callbacks can load chunks and merge or split layouts. Resolve again afterwards.
+        groups = this.group(candidates);
+        if (groups.size() < 2 || groups.containsKey(null)
+            || candidates.stream().anyMatch(ticker -> !ticker.fand$canTickInRegion())) {
+            candidates.forEach(tick);
+            return;
+        }
+        Map<TickRegion, Job> jobs = new LinkedHashMap<>();
+        groups.forEach((region, members) -> jobs.put(region, new Job(region.id(), members, this.level.getRandom().nextLong())));
+        var blockComponents = this.level.getDataStorage().get(io.fand.server.component.PersistentComponentData.blockType());
+        AtomicInteger running = new AtomicInteger();
+        AtomicInteger peak = new AtomicInteger();
+        RegionTickExecutor dispatcher = RegionTickExecutor.forPhases(workers.executor(), context -> {
+            Job job = jobs.get(context.region());
+            try (RegionTickScope scope = new RegionTickScope(this.level, context, job.publications, job.seed, blockComponents)) {
+                job.thread = Thread.currentThread().getName();
+                job.start = System.nanoTime();
+                peak.accumulateAndGet(running.incrementAndGet(), Math::max);
+                try {
+                    for (TickingBlockEntity ticker : job.tickers) {
+                        if (!ticker.isRemoved()) {
+                            scope.requirePosition(this.level, ticker.getPos());
+                        }
+                        tick.accept(ticker);
+                        job.ticked++;
+                    }
+                } finally {
+                    job.end = System.nanoTime();
+                    running.decrementAndGet();
+                }
+            }
+        });
+        List<CompletableFuture<RegionTickExecutor.Result>> results = new ArrayList<>();
+        Throwable failure = null;
+        try {
+            for (TickRegion region : jobs.keySet()) {
+                results.add(dispatcher.tick(region));
+            }
+        } catch (RuntimeException | Error thrown) {
+            failure = thrown;
+        }
+        try {
+            // Do not pump the server event loop here: it publishes and unloads live world data.
+            CompletableFuture.allOf(results.toArray(CompletableFuture[]::new)).join();
+            if (results.stream().anyMatch(result -> result.join() != RegionTickExecutor.Result.EXECUTED)) {
+                throw new IllegalStateException("Region layout changed during a native simulation phase");
+            }
+        } catch (CompletionException thrown) {
+            if (failure == null) {
+                failure = thrown.getCause();
+            } else if (failure != thrown.getCause()) {
+                failure.addSuppressed(thrown.getCause());
+            }
+        } catch (RuntimeException | Error thrown) {
+            if (failure == null) {
+                failure = thrown;
+            } else if (failure != thrown) {
+                failure.addSuppressed(thrown);
+            }
+        } finally {
+            dispatcher.shutdown().join();
+            for (Job job : jobs.values()) {
+                for (Runnable publication : job.publications) {
+                    try {
+                        publication.run();
+                    } catch (RuntimeException | Error thrown) {
+                        if (failure == null) {
+                            failure = thrown;
+                        } else if (failure != thrown) {
+                            failure.addSuppressed(thrown);
+                        }
+                    }
+                }
+            }
+        }
+        if (failure instanceof Error error) {
+            throw error;
+        }
+        if (failure != null) {
+            throw new CompletionException("Native region block-entity phase failed", failure);
+        }
+        this.completedPhases++;
+        this.completedTickers += jobs.values().stream().mapToInt(job -> job.ticked).sum();
+        this.peakConcurrency = Math.max(this.peakConcurrency, peak.get());
+        this.snapshot = new Snapshot(this.completedPhases, this.completedTickers, this.peakConcurrency, jobs.size(),
+            jobs.values().stream().limit(32).map(job -> new Execution(job.regionId, job.thread, job.ticked, job.start, job.end)).toList());
+    }
+
+    private Map<TickRegion, List<TickingBlockEntity>> group(List<TickingBlockEntity> tickers) {
+        Map<TickRegion, List<TickingBlockEntity>> groups = new LinkedHashMap<>();
+        for (TickingBlockEntity ticker : tickers) {
+            var pos = ticker.getPos();
+            var chunkMap = this.level.getChunkSource().chunkMap;
+            var region = chunkMap.fand$regionAt(chunkMap.fand$cellAtChunk(pos.getX() >> 4, pos.getZ() >> 4));
+            groups.computeIfAbsent(region, ignored -> new ArrayList<>()).add(ticker);
+        }
+        return groups;
+    }
+
+    public record Snapshot(long completedPhases, long completedTickers, int peakConcurrentRegions,
+                           int lastRegionCount, List<Execution> lastExecutions) {}
+    public record Execution(long regionId, String thread, int tickers, long startNanos, long endNanos) {}
+
+    private static final class Job {
+        private final long regionId;
+        private final List<TickingBlockEntity> tickers;
+        private final long seed;
+        private final List<Runnable> publications = new ArrayList<>();
+        private String thread = "";
+        private long start;
+        private long end;
+        private int ticked;
+
+        private Job(long regionId, List<TickingBlockEntity> tickers, long seed) {
+            this.regionId = regionId;
+            this.tickers = tickers;
+            this.seed = seed;
+        }
+    }
+}
diff --git a/net/minecraft/server/level/RegionTickScope.java b/net/minecraft/server/level/RegionTickScope.java
new file mode 100644
index 0000000000000000000000000000000000000000..61f66e51860759b9cced61c31403970c73d671ab
--- /dev/null
+++ b/net/minecraft/server/level/RegionTickScope.java
@@ -0,0 +1,125 @@
+package net.minecraft.server.level;
+
+import io.fand.server.tick.OwnershipCell;
+import io.fand.server.tick.RegionContext;
+import io.fand.server.component.PersistentComponentData;
+import java.util.List;
+import net.minecraft.core.BlockPos;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.redstone.CollectingNeighborUpdater;
+import net.minecraft.world.phys.AABB;
+import org.jspecify.annotations.Nullable;
+
+/** Native permission for one joined world phase, in addition to the topology lease. */
+public final class RegionTickScope implements AutoCloseable {
+    private static final ThreadLocal<RegionTickScope> CURRENT = new ThreadLocal<>();
+    private final ServerLevel level;
+    private final RegionContext context;
+    private final List<Runnable> publications;
+    private final RandomSource random;
+    private final CollectingNeighborUpdater neighborUpdater;
+    private final @Nullable PersistentComponentData blockComponents;
+    private final java.util.Map<Long, io.fand.api.component.DataComponentMap> changedComponents = new java.util.HashMap<>();
+    private int randomPosition;
+
+    RegionTickScope(ServerLevel level, RegionContext context, List<Runnable> publications, long seed,
+                    @Nullable PersistentComponentData blockComponents) {
+        if (CURRENT.get() != null || RegionContext.current().orElse(null) != context) {
+            throw new IllegalStateException("Native region scope requires its current topology lease");
+        }
+        this.level = level;
+        this.context = context;
+        this.publications = publications;
+        this.random = RandomSource.create(seed);
+        this.randomPosition = (int)seed;
+        this.neighborUpdater = level.fand$newRegionNeighborUpdater();
+        this.blockComponents = blockComponents;
+        CURRENT.set(this);
+    }
+
+    public static @Nullable RegionTickScope current() {
+        return CURRENT.get();
+    }
+
+    public static boolean defer(Level level, Runnable publication) {
+        RegionTickScope scope = CURRENT.get();
+        if (scope == null) {
+            return false;
+        }
+        scope.requireLevel(level);
+        scope.publications.add(publication);
+        return true;
+    }
+
+    public void requireLevel(Level level) {
+        if (this.level != level || CURRENT.get() != this || RegionContext.current().orElse(null) != this.context) {
+            throw new IllegalStateException("World is outside the current native region phase");
+        }
+    }
+
+    public void requireChunk(Level level, int x, int z) {
+        this.requireLevel(level);
+        this.context.requireOwned(this.level.getChunkSource().chunkMap.fand$cellAtChunk(x, z));
+    }
+
+    public void requirePosition(Level level, BlockPos pos) {
+        this.requireChunk(level, pos.getX() >> 4, pos.getZ() >> 4);
+    }
+
+    public void requireArea(Level level, AABB box) {
+        this.requireLevel(level);
+        OwnershipCell min = this.level.getChunkSource().chunkMap.fand$cellAtChunk(
+            net.minecraft.util.Mth.floor(box.minX) >> 4, net.minecraft.util.Mth.floor(box.minZ) >> 4);
+        OwnershipCell max = this.level.getChunkSource().chunkMap.fand$cellAtChunk(
+            net.minecraft.util.Mth.floor(box.maxX) >> 4, net.minecraft.util.Mth.floor(box.maxZ) >> 4);
+        for (int x = min.x(); x <= max.x(); x++) {
+            for (int z = min.z(); z <= max.z(); z++) {
+                this.context.requireOwned(new OwnershipCell(x, z));
+            }
+        }
+    }
+
+    public RandomSource random(Level level) {
+        this.requireLevel(level);
+        return this.random;
+    }
+
+    public io.fand.api.component.DataComponentMap blockComponents(Level level, BlockPos pos) {
+        this.requirePosition(level, pos);
+        var changed = this.changedComponents.get(pos.asLong());
+        return changed != null ? changed : this.blockComponents == null ? io.fand.api.component.DataComponentMap.EMPTY
+            : this.blockComponents.get(Long.toString(pos.asLong()));
+    }
+
+    public void blockComponents(Level level, BlockPos pos, io.fand.api.component.DataComponentMap components) {
+        this.requirePosition(level, pos);
+        this.changedComponents.put(pos.asLong(), components);
+        BlockPos immutable = pos.immutable();
+        this.publications.add(() -> io.fand.server.component.BlockComponentStorage.put(this.level, immutable, components));
+    }
+
+    public int nextRandomPosition(Level level) {
+        this.requireLevel(level);
+        this.randomPosition = this.randomPosition * 3 + 1013904223;
+        return this.randomPosition >> 2;
+    }
+
+    public CollectingNeighborUpdater neighborUpdater(Level level) {
+        this.requireLevel(level);
+        return this.neighborUpdater;
+    }
+
+    public void requireTickAccess(Object ticks, BlockPos pos) {
+        if (ticks != this.level.getBlockTicks() && ticks != this.level.getFluidTicks()) {
+            throw new IllegalStateException("Scheduled tick access belongs to another world");
+        }
+        this.requirePosition(this.level, pos);
+    }
+
+    @Override
+    public void close() {
+        this.requireLevel(this.level);
+        CURRENT.remove();
+    }
+}
