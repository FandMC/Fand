@@ -0,0 +1,125 @@
+package net.minecraft.world.level;
+
+import io.fand.server.tick.OwnershipCell;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import java.util.function.Predicate;
+import net.minecraft.core.BlockPos;
+import org.jspecify.annotations.Nullable;
+
+/** Pending events belong to cells; their heads preserve the serial world's insertion order. */
+public final class BlockEventQueue {
+    private final Function<BlockPos, OwnershipCell> cellAt;
+    private final Map<OwnershipCell, LinkedHashMap<BlockEventData, Long>> cells = new HashMap<>();
+    private final TreeMap<Long, OwnershipCell> heads = new TreeMap<>();
+    private @Nullable List<BlockEventData> deferred;
+    private long nextOrder;
+
+    public BlockEventQueue(Function<BlockPos, OwnershipCell> cellAt) {
+        this.cellAt = cellAt;
+    }
+
+    public void add(BlockEventData event) {
+        OwnershipCell pos = this.cellAt.apply(event.pos());
+        var cell = this.cells.get(pos);
+        if (cell != null && cell.containsKey(event)) {
+            return;
+        }
+        long order = this.nextOrder;
+        this.nextOrder = Math.incrementExact(order);
+        if (cell == null) {
+            cell = new LinkedHashMap<>();
+            this.cells.put(pos, cell);
+        }
+        cell.put(event, order);
+        if (cell.size() == 1) {
+            this.heads.put(order, pos);
+        }
+    }
+
+    private @Nullable BlockEventData poll() {
+        var head = this.heads.pollFirstEntry();
+        if (head == null) {
+            return null;
+        }
+        var cell = this.cells.get(head.getValue());
+        BlockEventData event = cell.pollFirstEntry().getKey();
+        if (cell.isEmpty()) {
+            this.cells.remove(head.getValue());
+        } else {
+            this.heads.put(cell.firstEntry().getValue(), head.getValue());
+        }
+        return event;
+    }
+
+    public void run(Predicate<BlockPos> shouldTick, Consumer<BlockEventData> output) {
+        if (this.deferred != null) {
+            throw new IllegalStateException("Block events cannot be reentered");
+        }
+        List<BlockEventData> deferred = new ArrayList<>();
+        this.deferred = deferred;
+        try {
+            BlockEventData event;
+            while ((event = this.poll()) != null) {
+                if (shouldTick.test(event.pos())) {
+                    output.accept(event);
+                } else {
+                    deferred.add(event);
+                }
+            }
+        } finally {
+            this.deferred = null;
+            deferred.forEach(this::add);
+        }
+    }
+
+    public void removeIf(Predicate<BlockEventData> predicate) {
+        for (var iterator = this.cells.entrySet().iterator(); iterator.hasNext();) {
+            var entry = iterator.next();
+            var cell = entry.getValue();
+            this.heads.remove(cell.firstEntry().getValue());
+            cell.keySet().removeIf(predicate);
+            if (cell.isEmpty()) {
+                iterator.remove();
+            } else {
+                this.heads.put(cell.firstEntry().getValue(), entry.getKey());
+            }
+        }
+        if (this.deferred != null) {
+            this.deferred.removeIf(predicate);
+        }
+    }
+
+    public void removeChunk(ChunkPos pos) {
+        OwnershipCell cellPos = this.cellAt.apply(pos.getWorldPosition());
+        var cell = this.cells.get(cellPos);
+        Predicate<BlockEventData> inChunk = event -> ChunkPos.pack(event.pos()) == pos.pack();
+        if (cell != null) {
+            this.heads.remove(cell.firstEntry().getValue());
+            cell.keySet().removeIf(inChunk);
+            if (cell.isEmpty()) {
+                this.cells.remove(cellPos);
+            } else {
+                this.heads.put(cell.firstEntry().getValue(), cellPos);
+            }
+        }
+        if (this.deferred != null) {
+            this.deferred.removeIf(inChunk);
+        }
+    }
+
+    public Map<OwnershipCell, Integer> cellCounts() {
+        Map<OwnershipCell, Integer> counts = new TreeMap<>();
+        this.cells.forEach((pos, cell) -> counts.put(pos, cell.size()));
+        if (this.deferred != null) {
+            this.deferred.forEach(event -> counts.merge(this.cellAt.apply(event.pos()), 1, Integer::sum));
+        }
+        return java.util.Collections.unmodifiableMap(counts);
+    }
+}
