diff --git a/net/minecraft/world/ticks/CellTickContainerIndex.java b/net/minecraft/world/ticks/CellTickContainerIndex.java
new file mode 100644
index 0000000000000000000000000000000000000000..3848c0e7466020778472245d0329ad0711237fa0
--- /dev/null
+++ b/net/minecraft/world/ticks/CellTickContainerIndex.java
@@ -0,0 +1,175 @@
+package net.minecraft.world.ticks;
+
+import io.fand.server.tick.OwnershipCell;
+import it.unimi.dsi.fastutil.longs.Long2ObjectMap;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.NavigableSet;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.function.LongFunction;
+import org.jspecify.annotations.Nullable;
+
+/** Cell-owned containers, with one live deadline entry per container and per cell. */
+final class CellTickContainerIndex<T> {
+    private final LongFunction<OwnershipCell> cellAtChunk;
+    private final Map<OwnershipCell, Cell<T>> cells = new HashMap<>();
+    private final NavigableSet<Cell<T>> scheduledCells = new TreeSet<>(Comparator
+        .<Cell<T>>comparingLong(cell -> cell.scheduled.first().nextTick)
+        .thenComparing(cell -> cell.pos));
+
+    CellTickContainerIndex(LongFunction<OwnershipCell> cellAtChunk) {
+        this.cellAtChunk = cellAtChunk;
+    }
+
+    Registration<T> add(long chunkPos, LevelChunkTicks<T> container) {
+        OwnershipCell pos = this.cellAtChunk.apply(chunkPos);
+        Cell<T> cell = this.cells.computeIfAbsent(pos, Cell::new);
+        Registration<T> registration = new Registration<>(chunkPos, container, cell);
+        cell.containers.put(chunkPos, registration);
+        container.setOnTickAdded((source, tick) -> this.refresh(registration));
+        this.refresh(registration);
+        return registration;
+    }
+
+    @Nullable Registration<T> get(long chunkPos) {
+        Cell<T> cell = this.cells.get(this.cellAtChunk.apply(chunkPos));
+        return cell == null ? null : cell.containers.get(chunkPos);
+    }
+
+    boolean isCurrent(Registration<T> registration) {
+        return this.cells.get(registration.cell.pos) == registration.cell
+            && registration.cell.containers.get(registration.chunkPos) == registration;
+    }
+
+    @Nullable Registration<T> remove(long chunkPos) {
+        Registration<T> registration = this.get(chunkPos);
+        if (registration == null) {
+            return null;
+        }
+        this.unschedule(registration);
+        registration.container.setOnTickAdded(null);
+        Cell<T> cell = registration.cell;
+        cell.containers.remove(chunkPos);
+        if (cell.containers.isEmpty()) {
+            this.cells.remove(cell.pos);
+        }
+        return registration;
+    }
+
+    void refresh(Registration<T> registration) {
+        if (!this.isCurrent(registration)) {
+            return;
+        }
+        this.unschedule(registration);
+        ScheduledTick<T> next = registration.container.peek();
+        if (next != null) {
+            Cell<T> cell = registration.cell;
+            if (!cell.scheduled.isEmpty()) {
+                this.scheduledCells.remove(cell);
+            }
+            registration.nextTick = next.triggerTick();
+            registration.queued = true;
+            cell.scheduled.add(registration);
+            this.scheduledCells.add(cell);
+        }
+    }
+
+    private void unschedule(Registration<T> registration) {
+        if (registration.queued) {
+            Cell<T> cell = registration.cell;
+            this.scheduledCells.remove(cell);
+            cell.scheduled.remove(registration);
+            registration.queued = false;
+            if (!cell.scheduled.isEmpty()) {
+                this.scheduledCells.add(cell);
+            }
+        }
+    }
+
+    List<Registration<T>> due(long currentTick, boolean useDeadlineIndex) {
+        List<Registration<T>> due = new ArrayList<>();
+        if (useDeadlineIndex) {
+            for (Cell<T> cell : this.scheduledCells) {
+                if (cell.scheduled.first().nextTick > currentTick) {
+                    break;
+                }
+                for (Registration<T> registration : cell.scheduled) {
+                    if (registration.nextTick > currentTick) {
+                        break;
+                    }
+                    due.add(registration);
+                }
+            }
+        } else {
+            for (Cell<T> cell : this.cells.values()) {
+                for (Registration<T> registration : cell.containers.values()) {
+                    ScheduledTick<T> next = registration.container.peek();
+                    if (next != null && next.triggerTick() <= currentTick) {
+                        due.add(registration);
+                    }
+                }
+            }
+        }
+        // No live index iterator may survive callbacks or container retirement.
+        return due;
+    }
+
+    int count() {
+        int count = 0;
+        for (Cell<T> cell : this.cells.values()) {
+            for (Registration<T> registration : cell.containers.values()) {
+                count += registration.container.count();
+            }
+        }
+        return count;
+    }
+
+    Map<OwnershipCell, Integer> tickCounts() {
+        Map<OwnershipCell, Integer> counts = new TreeMap<>();
+        for (Cell<T> cell : this.cells.values()) {
+            int count = 0;
+            for (Registration<T> registration : cell.containers.values()) {
+                count += registration.container.count();
+            }
+            if (count != 0) {
+                counts.put(cell.pos, count);
+            }
+        }
+        return counts;
+    }
+
+    static final class Registration<T> {
+        final long chunkPos;
+        final LevelChunkTicks<T> container;
+        final Cell<T> cell;
+        private boolean queued;
+        private long nextTick;
+
+        private Registration(long chunkPos, LevelChunkTicks<T> container, Cell<T> cell) {
+            this.chunkPos = chunkPos;
+            this.container = container;
