index 0000000000000000000000000000000000000000..235b6e951969293607cf10d12f81ddad5e1670d0
--- /dev/null
+++ b/net/minecraft/server/level/RegionScheduledBlockTicker.java
@@ -0,0 +1,21 @@
+package net.minecraft.server.level;
+
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.RedstoneLampBlock;
+import net.minecraft.world.ticks.ScheduledTick;
+
+/** Scheduled callbacks are opted in only after auditing their synchronous side effects. */
+public final class RegionScheduledBlockTicker extends RegionTickDispatcher<ScheduledTick<Block>> {
+    public RegionScheduledBlockTicker(ServerLevel level) {
+        this(level, () -> io.fand.server.Main.runtime().regionSimulationWorkers());
+    }
+
+    RegionScheduledBlockTicker(ServerLevel level, java.util.function.Supplier<io.fand.server.tick.RegionSimulationWorkers> workers) {
+        super(level, workers, ScheduledTick::pos, tick -> supported(tick.type()), tick -> false);
+    }
+
+    static boolean supported(Block block) {
+        // Diodes and observers can synchronously activate arbitrary neighbors, including entity spawning.
+        return block.getClass() == RedstoneLampBlock.class;
+    }
+}
diff --git a/net/minecraft/server/level/RegionTickDispatcher.java b/net/minecraft/server/level/RegionTickDispatcher.java
new file mode 100644
index 0000000000000000000000000000000000000000..7be093213384b5c81c32bb83e2c840cfd1be6f83
--- /dev/null
+++ b/net/minecraft/server/level/RegionTickDispatcher.java
@@ -0,0 +1,181 @@
+package net.minecraft.server.level;
+
+import io.fand.server.tick.RegionTickExecutor;
+import io.fand.server.tick.TickRegion;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+import net.minecraft.core.BlockPos;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/** Executes independent native phase groups, joining before world publication resumes. */
+public class RegionTickDispatcher<T> {
+    private final ServerLevel level;
+    private final java.util.function.Supplier<io.fand.server.tick.RegionSimulationWorkers> workers;
+    private Snapshot snapshot = new Snapshot(0, 0, 0, 0, List.of());
+    private long completedPhases;
+    private long completedTickers;
+    private int peakConcurrency;
+
+    private final Function<T, BlockPos> position;
+    private final Predicate<T> supported;
+    private final Predicate<T> removed;
+
+    protected RegionTickDispatcher(ServerLevel level,
+            java.util.function.Supplier<io.fand.server.tick.RegionSimulationWorkers> workers,
+            Function<T, BlockPos> position, Predicate<T> supported, Predicate<T> removed) {
+        this.level = level;
+        this.workers = workers;
+        this.position = position;
+        this.supported = supported;
+        this.removed = removed;
+    }
+
+    public Snapshot snapshot() {
+        if (!this.level.getServer().isSameThread()) {
+            throw new IllegalStateException("Region phase diagnostics belong to the control thread");
+        }
+        return this.snapshot;
+    }
+
+    public void tick(List<T> tickers, Consumer<T> tick) {
+        var workers = this.workers.get();
+        if (workers.parallelism() == 1) {
+            tickers.forEach(tick);
+            return;
+        }
+        Map<TickRegion, List<T>> groups = this.group(tickers);
+        List<T> candidates = new ArrayList<>();
+        for (var entry : groups.entrySet()) {
+            if (entry.getKey() != null && entry.getValue().stream().allMatch(this.supported)) {
+                candidates.addAll(entry.getValue());
+            } else {
+                entry.getValue().forEach(tick);
+            }
+        }
+        // Control callbacks can load chunks and merge or split layouts. Resolve again afterwards.
+        groups = this.group(candidates);
+        if (groups.size() < 2 || groups.containsKey(null)
+            || candidates.stream().anyMatch(ticker -> !this.supported.test(ticker))) {
+            candidates.forEach(tick);
+            return;
+        }
+        Map<TickRegion, Job<T>> jobs = new LinkedHashMap<>();
+        groups.forEach((region, members) -> jobs.put(region, new Job<>(region.id(), members, this.level.getRandom().nextLong())));
+        var blockComponents = this.level.getDataStorage().get(io.fand.server.component.PersistentComponentData.blockType());
+        AtomicInteger running = new AtomicInteger();
+        AtomicInteger peak = new AtomicInteger();
+        RegionTickExecutor dispatcher = RegionTickExecutor.forPhases(workers.executor(), context -> {
+            Job<T> job = jobs.get(context.region());
+            try (RegionTickScope scope = new RegionTickScope(this.level, context, job.publications, job.seed, blockComponents)) {
+                job.thread = Thread.currentThread().getName();
+                job.start = System.nanoTime();
+                peak.accumulateAndGet(running.incrementAndGet(), Math::max);
+                try {
+                    for (T ticker : job.tickers) {
+                        if (!this.removed.test(ticker)) {
+                            scope.requirePosition(this.level, this.position.apply(ticker));
+                        }
+                        tick.accept(ticker);
+                        job.ticked++;
+                    }
+                } finally {
+                    job.end = System.nanoTime();
+                    running.decrementAndGet();
+                }
+            }
+        });
+        List<CompletableFuture<RegionTickExecutor.Result>> results = new ArrayList<>();
+        Throwable failure = null;
+        try {
+            for (TickRegion region : jobs.keySet()) {
+                results.add(dispatcher.tick(region));
+            }
+        } catch (RuntimeException | Error thrown) {
+            failure = thrown;
+        }
+        try {
+            // Do not pump the server event loop here: it publishes and unloads live world data.
+            CompletableFuture.allOf(results.toArray(CompletableFuture[]::new)).join();
+            if (results.stream().anyMatch(result -> result.join() != RegionTickExecutor.Result.EXECUTED)) {
+                throw new IllegalStateException("Region layout changed during a native simulation phase");
+            }
+        } catch (CompletionException thrown) {
+            if (failure == null) {
+                failure = thrown.getCause();
+            } else if (failure != thrown.getCause()) {
+                failure.addSuppressed(thrown.getCause());
+            }
+        } catch (RuntimeException | Error thrown) {
+            if (failure == null) {
+                failure = thrown;
+            } else if (failure != thrown) {
+                failure.addSuppressed(thrown);
+            }
+        } finally {
+            dispatcher.shutdown().join();
+            for (Job<T> job : jobs.values()) {
+                for (Runnable publication : job.publications) {
+                    try {
+                        publication.run();
+                    } catch (RuntimeException | Error thrown) {
+                        if (failure == null) {
+                            failure = thrown;
+                        } else if (failure != thrown) {
+                            failure.addSuppressed(thrown);
+                        }
+                    }
+                }
+            }
+        }
+        if (failure instanceof Error error) {
+            throw error;
+        }
+        if (failure != null) {
+            throw new CompletionException("Native region phase failed", failure);
+        }
+        this.completedPhases++;
+        this.completedTickers += jobs.values().stream().mapToInt(job -> job.ticked).sum();
+        this.peakConcurrency = Math.max(this.peakConcurrency, peak.get());
+        this.snapshot = new Snapshot(this.completedPhases, this.completedTickers, this.peakConcurrency, jobs.size(),
+            jobs.values().stream().limit(32).map(job -> new Execution(job.regionId, job.thread, job.ticked, job.start, job.end)).toList());
+    }
+
+    private Map<TickRegion, List<T>> group(List<T> tickers) {
+        Map<TickRegion, List<T>> groups = new LinkedHashMap<>();
+        for (T ticker : tickers) {
+            var pos = this.position.apply(ticker);
+            var chunkMap = this.level.getChunkSource().chunkMap;
+            var region = chunkMap.fand$regionAt(chunkMap.fand$cellAtChunk(pos.getX() >> 4, pos.getZ() >> 4));
+            groups.computeIfAbsent(region, ignored -> new ArrayList<>()).add(ticker);
+        }
+        return groups;
+    }
+
+    public record Snapshot(long completedPhases, long completedTickers, int peakConcurrentRegions,
+                           int lastRegionCount, List<Execution> lastExecutions) {}
+    public record Execution(long regionId, String thread, int tickers, long startNanos, long endNanos) {}
+
+    private static final class Job<T> {
+        private final long regionId;
+        private final List<T> tickers;
+        private final long seed;
+        private final List<Runnable> publications = new ArrayList<>();
+        private String thread = "";
+        private long start;
+        private long end;
+        private int ticked;
+
+        private Job(long regionId, List<T> tickers, long seed) {
+            this.regionId = regionId;
+            this.tickers = tickers;
+            this.seed = seed;
+        }
+    }
+}
