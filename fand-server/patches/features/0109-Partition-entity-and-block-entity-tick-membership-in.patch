@@ -0,0 +1,74 @@
+package net.minecraft.world.level.block.entity;
+
+import io.fand.server.tick.OwnershipCell;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.function.Predicate;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.CellTickList;
+
+/** Cell-owned live tickers and additions deferred until the next block-entity pass. */
+public final class BlockEntityTickList implements Iterable<TickingBlockEntity> {
+    private final CellTickList<TickingBlockEntity, TickingBlockEntity> active;
+    private final CellTickList<TickingBlockEntity, TickingBlockEntity> pending;
+    private boolean ticking;
+
+    public BlockEntityTickList(Function<BlockPos, OwnershipCell> cellOf) {
+        this.active = CellTickList.byIdentity(ticker -> cellOf.apply(ticker.getPos()));
+        this.pending = CellTickList.byIdentity(ticker -> cellOf.apply(ticker.getPos()));
+    }
+
+    public void add(TickingBlockEntity ticker) {
+        if (this.ticking) {
+            this.pending.add(ticker);
+        } else {
+            this.active.add(ticker);
+        }
+    }
+
+    public void remove(TickingBlockEntity ticker) {
+        this.active.remove(ticker);
+        this.pending.remove(ticker);
+    }
+
+    public void tick(boolean runsNormally, Predicate<BlockPos> shouldTick) {
+        if (this.ticking) {
+            throw new IllegalStateException("Block entity ticking cannot be reentered");
+        }
+        this.ticking = true;
+        try {
+            this.pending.forEach(this.active::add);
+            this.pending.clear();
+            this.active.forEach(ticker -> {
+                if (!this.active.contains(ticker)) {
+                    return;
+                }
+                if (ticker.isRemoved()) {
+                    this.active.remove(ticker);
+                } else if (runsNormally && shouldTick.test(ticker.getPos())) {
+                    ticker.tick();
+                }
+            });
+        } finally {
+            this.ticking = false;
+        }
+    }
+
+    public int size() {
+        return this.active.size();
+    }
+
+    public Map<OwnershipCell, Integer> cellSizes() {
+        return this.active.cellSizes();
+    }
+
+    public Map<OwnershipCell, Integer> pendingCellSizes() {
+        return this.pending.cellSizes();
+    }
+
+    @Override
+    public Iterator<TickingBlockEntity> iterator() {
+        return this.active.iterator();
+    }
+}
