diff --git a/net/minecraft/world/level/CellTickList.java b/net/minecraft/world/level/CellTickList.java
new file mode 100644
index 0000000000000000000000000000000000000000..d708f71231a48f3d10c62e936f138f5e4ee9a481
--- /dev/null
+++ b/net/minecraft/world/level/CellTickList.java
@@ -0,0 +1,171 @@
+package net.minecraft.world.level;
+
+import io.fand.server.tick.OwnershipCell;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.NavigableMap;
+import java.util.Objects;
+import java.util.PriorityQueue;
+import java.util.TreeMap;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Stores simulation members in cells while preserving registration order for
+ * the serial world tick. Moving a member keeps its order. The serial traversal
+ * is an immutable cached view, rebuilt only when membership or identity changes.
+ * This collection belongs to the world thread, not to concurrent region ticks.
+ */
+public final class CellTickList<K, T> implements Iterable<T> {
+    public static final OwnershipCell SINGLE_CELL = new OwnershipCell(0, 0);
+    private final Function<T, K> keyOf;
+    private final Function<T, OwnershipCell> cellOf;
+    private final Map<K, Entry<T>> index;
+    private final Map<OwnershipCell, NavigableMap<Long, Entry<T>>> cells = new HashMap<>();
+    private @Nullable List<T> orderedSnapshot;
+    private long nextOrder;
+
+    public CellTickList(Function<T, K> keyOf, Function<T, OwnershipCell> cellOf) {
+        this(keyOf, cellOf, new HashMap<>());
+    }
+
+    private CellTickList(Function<T, K> keyOf, Function<T, OwnershipCell> cellOf, Map<K, Entry<T>> index) {
+        this.keyOf = Objects.requireNonNull(keyOf);
+        this.cellOf = Objects.requireNonNull(cellOf);
+        this.index = index;
+    }
+
+    public static <T> CellTickList<T, T> byIdentity(Function<T, OwnershipCell> cellOf) {
+        return new CellTickList<>(Function.identity(), cellOf, new IdentityHashMap<>());
+    }
+
+    public void add(T value) {
+        K key = this.keyOf.apply(value);
+        OwnershipCell cell = this.cellOf.apply(value);
+        Entry<T> previous = this.index.get(key);
+        if (previous != null && previous.value == value && previous.cell.equals(cell)) {
+            return;
+        }
+        long order;
+        if (previous == null) {
+            order = this.nextOrder;
+            this.nextOrder = Math.incrementExact(this.nextOrder);
+        } else {
+            order = previous.order;
+            this.removeFromCell(previous);
+        }
+        Entry<T> entry = new Entry<>(value, cell, order);
+        this.cells.computeIfAbsent(cell, ignored -> new TreeMap<>()).put(order, entry);
+        this.index.put(key, entry);
+        if (previous == null || previous.value != value) {
+            this.orderedSnapshot = null;
+        }
+    }
+
+    public void move(T value) {
+        Entry<T> entry = this.index.get(this.keyOf.apply(value));
+        if (entry != null && entry.value == value) {
+            this.add(value);
+        }
+    }
+
+    public void remove(T value) {
+        K key = this.keyOf.apply(value);
+        Entry<T> entry = this.index.get(key);
+        if (entry != null && entry.value == value) {
+            this.removeFromCell(entry);
+            this.index.remove(key);
+            this.orderedSnapshot = null;
+        }
+    }
+
+    private void removeFromCell(Entry<T> entry) {
+        NavigableMap<Long, Entry<T>> cell = this.cells.get(entry.cell);
+        cell.remove(entry.order);
+        if (cell.isEmpty()) {
+            this.cells.remove(entry.cell);
+        }
+    }
+
+    public boolean contains(T value) {
+        Entry<T> entry = this.index.get(this.keyOf.apply(value));
+        return entry != null && entry.value == value;
+    }
+
+    public int size() {
+        return this.index.size();
+    }
+
+    public void clear() {
+        this.index.clear();
+        this.cells.clear();
+        this.orderedSnapshot = null;
+    }
+
+    public Map<OwnershipCell, Integer> cellSizes() {
+        Map<OwnershipCell, Integer> counts = new TreeMap<>();
+        this.cells.forEach((cell, members) -> counts.put(cell, members.size()));
+        return java.util.Collections.unmodifiableMap(counts);
+    }
+
+    @Override
+    public void forEach(Consumer<? super T> output) {
+        this.snapshot().forEach(output);
+    }
+
+    private List<T> snapshot() {
+        if (this.orderedSnapshot != null) {
+            return this.orderedSnapshot;
+        }
+        List<T> snapshot = new ArrayList<>(this.size());
+        if (this.cells.size() == 1) {
+            this.cells.values().iterator().next().values().forEach(entry -> snapshot.add(entry.value));
+        } else {
+            PriorityQueue<Cursor<T>> cursors = new PriorityQueue<>(Comparator.comparingLong(cursor -> cursor.next.order));
+            for (var cell : this.cells.values()) {
+                cursors.add(new Cursor<>(cell.values().iterator()));
+            }
+            Cursor<T> cursor;
+            while ((cursor = cursors.poll()) != null) {
+                snapshot.add(cursor.next.value);
+                if (cursor.advance()) {
+                    cursors.add(cursor);
+                }
+            }
+        }
+        this.orderedSnapshot = java.util.Collections.unmodifiableList(snapshot);
+        return this.orderedSnapshot;
+    }
+
+    /** Diagnostic iteration is also a stable snapshot, including during a tick. */
+    @Override
+    public Iterator<T> iterator() {
+        return this.snapshot().iterator();
+    }
+
+    private record Entry<T>(T value, OwnershipCell cell, long order) {}
+
+    private static final class Cursor<T> {
+        private final Iterator<Entry<T>> entries;
+        private Entry<T> next;
+
+        private Cursor(Iterator<Entry<T>> entries) {
+            this.entries = entries;
+            this.next = entries.next();
+        }
+
+        private boolean advance() {
+            if (!this.entries.hasNext()) {
+                return false;
+            }
+            this.next = this.entries.next();
+            return true;
+        }
+    }
+}
