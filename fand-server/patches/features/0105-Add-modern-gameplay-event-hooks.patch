-        if (!this.useItem.isEmpty() && this.isUsingItem()) {
-            if (!io.fand.server.event.PlayerEvents.fireItemConsume(this, this.useItem.copy())) {
-                this.stopUsingItem();
-                return;
-            }
-            this.connection.send(new ClientboundEntityEventPacket(this, EntityEvent.USE_ITEM_COMPLETE));
-            super.completeUsingItem();
+    protected boolean fand$beforeCompleteUsingItem(final InteractionHand hand) {
+        if (!super.fand$beforeCompleteUsingItem(hand)
+            || !io.fand.server.event.PlayerEvents.fireItemConsume(this, this.useItem.copy())) {
+            return false;
         }
+        this.connection.send(new ClientboundEntityEventPacket(this, EntityEvent.USE_ITEM_COMPLETE));
+        return true;
