diff --git a/net/minecraft/server/level/RegionTickDispatcher.java b/net/minecraft/server/level/RegionTickDispatcher.java
index 7be093213384b5c81c32bb83e2c840cfd1be6f83..910c711d2a121bb86ac51149faecdfbb6e791a28 100644
--- a/net/minecraft/server/level/RegionTickDispatcher.java
+++ b/net/minecraft/server/level/RegionTickDispatcher.java
@@ -51,12 +51,25 @@ public class RegionTickDispatcher<T> {
             return;
         }
         Map<TickRegion, List<T>> groups = this.group(tickers);
-        List<T> candidates = new ArrayList<>();
+        var eligible = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<T, Boolean>());
+        int eligibleRegions = 0;
         for (var entry : groups.entrySet()) {
             if (entry.getKey() != null && entry.getValue().stream().allMatch(this.supported)) {
-                candidates.addAll(entry.getValue());
+                eligible.addAll(entry.getValue());
+                eligibleRegions++;
+            }
+        }
+        // A serial fallback must keep the original world order, including interleaved regions.
+        if (eligibleRegions < 2) {
+            tickers.forEach(tick);
+            return;
+        }
+        List<T> candidates = new ArrayList<>();
+        for (T ticker : tickers) {
+            if (eligible.contains(ticker)) {
+                candidates.add(ticker);
             } else {
-                entry.getValue().forEach(tick);
+                tick.accept(ticker);
             }
         }
         // Control callbacks can load chunks and merge or split layouts. Resolve again afterwards.
