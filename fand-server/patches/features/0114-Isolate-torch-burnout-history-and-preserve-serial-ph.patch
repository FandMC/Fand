diff --git a/net/minecraft/world/level/block/RedstoneTorchHistory.java b/net/minecraft/world/level/block/RedstoneTorchHistory.java
new file mode 100644
index 0000000000000000000000000000000000000000..1c635b0c909f0d817f4df9bb31e274f3fa894517
--- /dev/null
+++ b/net/minecraft/world/level/block/RedstoneTorchHistory.java
@@ -0,0 +1,51 @@
+package net.minecraft.world.level.block;
+
+import java.util.ArrayDeque;
+import java.util.concurrent.ConcurrentHashMap;
+import net.minecraft.core.BlockPos;
+
+/** World-owned burnout history. Position keys remain stable when regions merge or split. */
+public final class RedstoneTorchHistory {
+    private final ConcurrentHashMap<BlockPos, ArrayDeque<Long>> toggles = new ConcurrentHashMap<>();
+
+    public boolean isBurnedOut(BlockPos pos, long time, boolean add) {
+        boolean[] burnedOut = new boolean[1];
+        this.toggles.compute(pos.immutable(), (key, recent) -> {
+            if (recent == null) {
+                if (!add) {
+                    return null;
+                }
+                recent = new ArrayDeque<>(RedstoneTorchBlock.MAX_RECENT_TOGGLES);
+            }
+            expire(recent, time);
+            if (add) {
+                // Only the latest eight transitions can affect the burnout predicate.
+                if (recent.size() == RedstoneTorchBlock.MAX_RECENT_TOGGLES) {
+                    recent.removeFirst();
+                }
+                recent.addLast(time);
+            }
+            burnedOut[0] = recent.size() >= RedstoneTorchBlock.MAX_RECENT_TOGGLES;
+            return recent.isEmpty() ? null : recent;
+        });
+        return burnedOut[0];
+    }
+
+    /** Called once per world tick outside native worker phases, including worlds with no torch ticks. */
+    public void expire(long time) {
+        this.toggles.forEach((pos, ignored) -> this.toggles.computeIfPresent(pos, (key, recent) -> {
+            expire(recent, time);
+            return recent.isEmpty() ? null : recent;
+        }));
+    }
+
+    private static void expire(ArrayDeque<Long> recent, long time) {
+        while (!recent.isEmpty() && time - recent.getFirst() > RedstoneTorchBlock.RECENT_TOGGLE_TIMER) {
+            recent.removeFirst();
+        }
+    }
+
+    int trackedPositions() {
+        return this.toggles.size();
+    }
+}
